# Copy to .env and fill in. up.sh does this for you interactively.

# Kismet REST base URL. host.docker.internal resolves to the Docker host from
# inside the exporter container (see extra_hosts in docker-compose.yml).
KISMET_URL=http://host.docker.internal:2501

# Required in live mode. Create one in the Kismet web UI: Settings -> API Keys.
# Not needed when running the exporter with --demo / DEMO_MODE=1.
KISMET_API_KEY=

# Set to 1 if your Kismet build expects the API key as the HTTP basic-auth
# password rather than the username.
KISMET_APIKEY_AS_PASSWORD=

EXPORTER_PORT=9102
POLL_INTERVAL=5
TOP_N=15

# Set to 1 to generate synthetic data instead of talking to Kismet.
DEMO_MODE=0

# Grafana admin password (used on first start only).
GRAFANA_PASSWORD=wardrive
